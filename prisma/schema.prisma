generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  createdAt     DateTime  @default(now())
  exchangeRate  Float     @default(42)
  accounts      Account[]
  categories    Category[]
  recurringExpenses RecurringExpense[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String   // "card", "cash", "crypto"
  balance   Float    @default(0)
  startingBalance Float @default(0)
  currency  String   @default("UAH")
  transactions Transaction[]
  recurringRules RecurringRule[]
  recurringExpenses RecurringExpense[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("expense") // "income", "expense"
  budgetLimit Float?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  transactions Transaction[]
  recurringRules RecurringRule[]
  recurringExpenses RecurringExpense[]
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  amount      Float
  date        DateTime @default(now())
  type        String   // "expense", "income"
  comment     String?
  isRecurring Boolean  @default(false)
  recurringExpenseId String?
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
}

model RecurringRule {
  id          String   @id @default(cuid())
  dayOfMonth  Int
  amount      Float
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
}

model RecurringExpense {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  name               String
  amount             Float
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  recurrenceType     String    // DAILY, WEEKLY, MONTHLY, YEARLY
  recurrenceInterval Int
  startDate          DateTime
  lastAppliedDate    DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  transactions       Transaction[]
}
